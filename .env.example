# AutoScenarioWriter/.env 예시 파일
# 웹 초기 설정 페이지에서 API 키를 입력하면 이 형식의 .env 파일이 자동 생성됩니다.
# (로컬 Ollama 사용 시에는 API 키가 필요하지 않습니다.)

GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# CUSTOM_API_KEY=your_custom_server_api_key_here
